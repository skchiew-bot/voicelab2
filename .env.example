# Postgres connection used by the app (owner role that runs migrations)
DATABASE_URL=postgres://voicelab:voicelab@localhost:5432/voicelab
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing this key makes stored provider credentials unreadable.
VOICELAB_SECRET_KEY=
PORT=3000
# Public address providers use to reach webhooks (https, no trailing slash). Required to place or receive calls.
PUBLIC_BASE_URL=
# How far our estimated call cost may differ from the provider's own figures and still count as reconciled (percent).
RECONCILE_TOLERANCE_PCT=2
# Whether this server runs the scheduled jobs (on by default; safe on every server at once).
SCHEDULER=on
# Sign-in emails (comma-separated) of the staff who may put a flow live in production directly. Everyone else proposes a
# change that a different person approves. Empty: every production deploy needs an approved change.
PRODUCTION_DEPLOYERS=
