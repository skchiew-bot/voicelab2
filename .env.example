# Postgres connection used by the app (owner role that runs migrations)
DATABASE_URL=postgres://voicelab:voicelab@localhost:5432/voicelab
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing this key makes stored provider credentials unreadable.
VOICELAB_SECRET_KEY=
PORT=3000
# Public address providers use to reach webhooks (https, no trailing slash). Required to place or receive calls.
PUBLIC_BASE_URL=
